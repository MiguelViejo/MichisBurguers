<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".Register">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imageLogoRegistro"
            android:layout_width="231dp"
            android:layout_height="116dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/app_name"
            app:srcCompat="@drawable/images"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textTituloRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/registro_titulo"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/imageLogoRegistro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Usuario -->
        <TextView
            android:id="@+id/textUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/usuario"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/textTituloRegistro"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/EditTextRegUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="username"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/textUsuario"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Correo -->
        <TextView
            android:id="@+id/textCorreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/correo_label"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/EditTextRegUsuario"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/EditTextRegCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="emailAddress"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@id/textCorreo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Contraseña -->
        <TextView
            android:id="@+id/textRegContrasena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/contrase_a"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/EditTextRegCorreo"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/EditTextRegContrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="newPassword"
            android:inputType="textPassword"
            app:layout_constraintTop_toBottomOf="@id/textRegContrasena"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Repetir contraseña -->
        <TextView
            android:id="@+id/textRepetir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/repetir_contrasena"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/EditTextRegContrasena"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/EditTextRegRepetir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="newPassword"
            android:inputType="textPassword"
            app:layout_constraintTop_toBottomOf="@id/textRepetir"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botones -->
        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="@string/crear_cuenta"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/EditTextRegRepetir"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnYaTengoCuenta"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/ya_tengo_cuenta"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/btnCrearCuenta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
